<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GraphDoku.App.ViewModels"
        xmlns:controls="using:GraphDoku.App.Controls"
        xmlns:rules="using:GraphDoku.Core.Rules"
        xmlns:views="using:GraphDoku.App.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="GraphDoku.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Resources>
    <!-- Parameterfelder, erzeugt aus den Parameterbeschreibungen der Regel (IRule.Parameters). -->
    <DataTemplate x:Key="ParameterList" x:DataType="vm:ConstraintPropertiesViewModel">
      <StackPanel Spacing="6">
        <TextBlock Text="Parameter" FontWeight="SemiBold" Margin="0,6,0,0" IsVisible="{Binding HasParameters}" />
        <TextBlock Text="Diese Regel hat keine Parameter." Classes="hint" IsVisible="{Binding !HasParameters}" />
        <ItemsControl ItemsSource="{Binding Parameters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RuleParameterViewModel">
              <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" />
                <TextBox Text="{Binding Text}" IsVisible="{Binding IsInteger}" />
                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBoolean}" />
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding Converter={x:Static views:Converters.ChoiceLabel}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding Description}" Classes="hint" />
                <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#b42318" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="WrapPanel.toolbar > :is(Button)">
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="WrapPanel.toolbar > RadioButton">
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Datei">
        <MenuItem Header="_Neu …" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="Vorlage „Klassisch 9×9“" Command="{Binding NewClassicCommand}" />
        <Separator />
        <MenuItem Header="Ö_ffnen …" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="_Speichern" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Speichern _unter …" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
      </MenuItem>
      <MenuItem Header="_Bearbeiten">
        <MenuItem Header="{Binding Editor.UndoText}" Command="{Binding Editor.UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="{Binding Editor.RedoText}" Command="{Binding Editor.RedoCommand}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Auswahl löschen (Entf)" Command="{Binding Editor.DeleteSelectionCommand}" />
        <MenuItem Header="Givens der Auswahl löschen (⌫)" Command="{Binding Editor.ClearGivensCommand}" />
        <MenuItem Header="Alle Knoten auswählen" Command="{Binding Editor.SelectAllCommand}" InputGesture="Ctrl+A" />
        <Separator />
        <MenuItem Header="Gruppe aus Auswahl erstellen" Command="{Binding Editor.CreateGroupFromSelectionCommand}" InputGesture="Ctrl+G" />
      </MenuItem>
      <MenuItem Header="_Ansicht">
        <MenuItem Header="Einpassen" Command="{Binding Editor.FitViewCommand}" InputGesture="Ctrl+0" />
        <MenuItem Header="Vergrößern" Command="{Binding Editor.ZoomInCommand}" />
        <MenuItem Header="Verkleinern" Command="{Binding Editor.ZoomOutCommand}" />
        <Separator />
        <MenuItem Header="Alle Gruppen einblenden" Command="{Binding Editor.ShowAllGroupsCommand}" />
        <MenuItem Header="Alle Gruppen ausblenden" Command="{Binding Editor.HideAllGroupsCommand}" />
      </MenuItem>
      <MenuItem Header="_Lösen">
        <MenuItem Header="_Lösen" Command="{Binding Solve.SolveCommand}" InputGesture="F5" />
        <MenuItem Header="_Eindeutigkeit prüfen" Command="{Binding Solve.CheckUniquenessCommand}" InputGesture="F6" />
        <MenuItem Header="_Abbrechen" Command="{Binding Solve.CancelCommand}" />
        <Separator />
        <MenuItem Header="{Binding Solve.ShowFirstSolutionText}" Command="{Binding Solve.ShowFirstSolutionCommand}" />
        <MenuItem Header="Lösung 2 anzeigen" Command="{Binding Solve.ShowSecondSolutionCommand}" />
        <MenuItem Header="Lösung ausblenden" Command="{Binding Solve.HideSolutionCommand}" />
        <Separator />
        <MenuItem Header="E_rklären" Command="{Binding Explain.ExplainCommand}" InputGesture="F7" />
        <MenuItem Header="Erklärung abbrechen" Command="{Binding Explain.CancelCommand}" />
        <MenuItem Header="Kandidaten anzeigen" ToggleType="CheckBox" IsChecked="{Binding Explain.ShowCandidates, Mode=TwoWay}" />
        <MenuItem Header="Erklärung beenden" Command="{Binding Explain.CloseCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" BorderBrush="#dddddd" BorderThickness="0,0,0,1" Padding="8,6">
      <!-- WrapPanel: bei schmalem Fenster bricht die Werkzeugleiste um, statt Schaltflächen abzuschneiden. -->
      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Classes="toolbar">
        <RadioButton GroupName="tool" Content="Auswahl" IsChecked="{Binding Editor.IsSelectTool}" ToolTip.Tip="Auswählen und Verschieben" />
        <RadioButton GroupName="tool" Content="Knoten setzen" IsChecked="{Binding Editor.IsPlaceNodeTool}" ToolTip.Tip="Klick oder Ziehen setzt Knoten" />
        <RadioButton GroupName="tool" Content="Kante ziehen" IsChecked="{Binding Editor.IsDrawEdgeTool}" ToolTip.Tip="Von Knoten zu Knoten ziehen" />
        <RadioButton GroupName="tool" Content="Ansicht verschieben" IsChecked="{Binding Editor.IsPanTool}" ToolTip.Tip="Auch: mittlere/rechte Maustaste oder Leertaste + Ziehen" />
        <Rectangle Width="1" Fill="#dddddd" Margin="6,2" />
        <TextBlock Text="Kantenregel:" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Editor.EdgeRules}" SelectedItem="{Binding Editor.NewEdgeRule}" MinWidth="130">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="rules:IRule">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Rectangle Width="1" Fill="#dddddd" Margin="6,2" />
        <Button Content="Rückgängig" ToolTip.Tip="{Binding Editor.UndoText}" Command="{Binding Editor.UndoCommand}" />
        <Button Content="Wiederholen" ToolTip.Tip="{Binding Editor.RedoText}" Command="{Binding Editor.RedoCommand}" />
        <Button Content="Einpassen" Command="{Binding Editor.FitViewCommand}" />
      </WrapPanel>
    </Border>

    <!-- Lösen: links Befehle und Zeitlimit, darunter Lösung anzeigen/ausblenden; rechts Fortschritt mit Abbrechen bzw.
         Ergebnis und Legende. Die Farbe der Leiste zeigt die Einstufung des Ergebnisses. Die Höhe hängt nicht vom Ergebnis
         ab (reservierte Zeile für die Lösungs-Schaltflächen, Meldung höchstens zwei Zeilen, Langtext als Tooltip), damit
         die Zeichenfläche beim Lösen und Bearbeiten nicht springt; nur die Fehlerliste eines ungültigen Rätsels macht sie
         höher (Entscheidung Nr. 80). -->
    <Border x:Name="SolveBar" DockPanel.Dock="Top" Padding="8,5" BorderThickness="0,0,0,1"
            Background="{Binding Solve.Severity, Converter={x:Static views:Converters.SeverityBackground}}"
            BorderBrush="{Binding Solve.Severity, Converter={x:Static views:Converters.SeverityBorder}}">
      <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <Button Content="Lösen" Command="{Binding Solve.SolveCommand}" FontWeight="SemiBold" Padding="12,3"
                  ToolTip.Tip="Eine Lösung suchen und in die Knoten eintragen (F5)" />
          <Button Content="Eindeutigkeit prüfen" Command="{Binding Solve.CheckUniquenessCommand}" Padding="10,3"
                  ToolTip.Tip="Prüfen, ob es genau eine Lösung gibt (F6)" />
          <Button Content="Erklären" Command="{Binding Explain.ExplainCommand}" Padding="10,3"
                  ToolTip.Tip="Lösungsweg Schritt für Schritt erklären (F7)" />
          <TextBlock Text="Zeitlimit:" VerticalAlignment="Center" Margin="4,0,0,0" />
          <TextBox Text="{Binding Solve.TimeLimitText}" Width="56" MinWidth="0" MinHeight="0" Padding="6,3" HorizontalContentAlignment="Right"
                   VerticalContentAlignment="Center" ToolTip.Tip="Höchste Rechenzeit pro Solver-Aufruf in Sekunden (0,1 bis 3600)" />
          <TextBlock Text="s" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Die Zeile ist immer reserviert (MinHeight), auch ohne Schaltflächen. -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" MinHeight="28">
          <Button Content="{Binding Solve.ShowFirstSolutionText}" Command="{Binding Solve.ShowFirstSolutionCommand}" Padding="10,3"
                  IsVisible="{Binding Solve.IsShowFirstSolutionVisible}" />
          <Button Content="Lösung 2 anzeigen" Command="{Binding Solve.ShowSecondSolutionCommand}" Padding="10,3"
                  IsVisible="{Binding Solve.IsSecondSolutionAvailable}" />
          <Button Content="Lösung ausblenden" Command="{Binding Solve.HideSolutionCommand}" Padding="10,3"
                  IsVisible="{Binding Solve.IsSolutionShown}" />
        </StackPanel>
        <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1" Fill="#d0d0cc" Margin="10,2" />
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Solve.TimeLimitError}" Classes="error" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Solve.TimeLimitError}"
                     IsVisible="{Binding Solve.TimeLimitError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <DockPanel IsVisible="{Binding Solve.IsBusy}">
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="{Binding Solve.IsBusy}" Width="120" MinWidth="0" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Left" Content="Abbrechen" Command="{Binding Solve.CancelCommand}" Padding="10,3" Margin="0,0,10,0" />
            <TextBlock Text="{Binding Solve.BusyText}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock Text="{Binding Solve.ResultMessage}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" FontWeight="SemiBold"
                     ToolTip.Tip="{Binding Solve.ResultMessage}"
                     IsVisible="{Binding Solve.ResultMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="hint" MaxLines="2" TextTrimming="WordEllipsis" IsVisible="{Binding !Solve.HasStatus}"
                     ToolTip.Tip="{Binding $self.Text}"
                     Text="„Lösen“ trägt eine Lösung in die Knoten ein (ohne das Rätsel zu ändern); „Eindeutigkeit prüfen“ sucht nach einer zweiten Lösung; „Erklären“ zeigt den Lösungsweg Schritt für Schritt." />
          <ScrollViewer MaxHeight="72" IsVisible="{Binding Solve.HasResultDetails}">
            <ItemsControl ItemsSource="{Binding Solve.ResultDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="error" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="{Binding Solve.Legend}" Classes="hint" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Solve.Legend}" IsVisible="{Binding Solve.IsSolutionShown}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Schrittleiste des Erklär-Modus (Entscheidungen Nr. 101–111): eine Zeile mit Anfang/Zurück/Vor/Ende, Schieberegler,
         „Schritt n von N“, Kandidaten ein/aus und „Erklärung beenden“. Während der Berechnung Fortschritt mit Abbrechen;
         ohne Erklärung (ungültig, Fehler, veraltet) die Meldung mit „Schließen“. Begründung und Ergebnis stehen im Panel
         rechts. -->
    <Border x:Name="StepBar" DockPanel.Dock="Top" Padding="8,5" BorderThickness="0,0,0,1" IsVisible="{Binding Explain.IsBarVisible}"
            Background="{Binding Explain.BarSeverity, Converter={x:Static views:Converters.SeverityBackground}}"
            BorderBrush="{Binding Explain.BarSeverity, Converter={x:Static views:Converters.SeverityBorder}}">
      <Panel>
        <DockPanel IsVisible="{Binding Explain.IsActive}">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Erklärung" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="« Anfang" Command="{Binding Explain.FirstCommand}" Padding="8,3" ToolTip.Tip="Zur Ausgangslage (Pos1)" />
            <Button Content="‹ Zurück" Command="{Binding Explain.PreviousCommand}" Padding="8,3" ToolTip.Tip="Einen Schritt zurück (←)" />
            <Button Content="Vor ›" Command="{Binding Explain.NextCommand}" Padding="8,3" FontWeight="SemiBold" ToolTip.Tip="Nächster Schritt (→)" />
            <Button Content="Ende »" Command="{Binding Explain.LastCommand}" Padding="8,3" ToolTip.Tip="Zum letzten Schritt (Ende)" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Explain.StepCounterText}" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="120" TextAlignment="Right" />
            <CheckBox Content="Kandidaten" IsChecked="{Binding Explain.ShowCandidates}" MinWidth="0" ToolTip.Tip="Kandidaten in den offenen Knoten anzeigen" />
            <Button Content="{Binding Explain.CloseText}" Command="{Binding Explain.CloseCommand}" Padding="10,3" />
          </StackPanel>
          <Slider x:Name="StepSlider" Minimum="0" Maximum="{Binding Explain.StepCount}" Value="{Binding Explain.SliderValue}"
                  TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" Margin="12,0" MinWidth="80"
                  VerticalAlignment="Center" ToolTip.Tip="Schritt wählen" />
        </DockPanel>
        <DockPanel IsVisible="{Binding Explain.IsBusy}">
          <ProgressBar DockPanel.Dock="Left" IsIndeterminate="{Binding Explain.IsBusy}" Width="120" MinWidth="0" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button DockPanel.Dock="Left" Content="Abbrechen" Command="{Binding Explain.CancelCommand}" Padding="10,3" Margin="0,0,10,0" />
          <TextBlock Text="{Binding Explain.BusyText}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DockPanel>
          <DockPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Explain.IsActive" />
              <Binding Path="!Explain.IsBusy" />
            </MultiBinding>
          </DockPanel.IsVisible>
          <Button DockPanel.Dock="Right" Content="{Binding Explain.CloseText}" Command="{Binding Explain.CloseCommand}" Padding="10,3" Margin="10,0,0,0"
                  VerticalAlignment="Top" />
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding Explain.StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"
                       ToolTip.Tip="{Binding Explain.StatusMessage}" />
            <ScrollViewer MaxHeight="72" IsVisible="{Binding Explain.HasErrors}">
              <ItemsControl ItemsSource="{Binding Explain.Errors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="error" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </DockPanel>
      </Panel>
    </Border>

    <!-- Statusbereich: letzte Aktion, Werkzeughinweis und Prüfmeldungen des PuzzleValidator. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#dddddd" BorderThickness="0,1,0,0" Padding="8,4" Background="#f4f4f2">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.StatusMessage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.ToolHint}" Classes="hint" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.ValidationSummary}" Margin="0,4,0,0"
                   Foreground="{Binding Editor.HasValidationProblems, Converter={x:Static views:Converters.ProblemBrush}}" />
        <ScrollViewer MaxHeight="90" IsVisible="{Binding Editor.HasValidationProblems}">
          <ItemsControl ItemsSource="{Binding Editor.ValidationProblems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="error" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Gruppenliste -->
    <Border DockPanel.Dock="Left" Width="240" BorderBrush="#dddddd" BorderThickness="0,0,1,0" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Gruppen" Classes="header" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
          <Button Content="Alle ein" Command="{Binding Editor.ShowAllGroupsCommand}" Padding="8,2" />
          <Button Content="Alle aus" Command="{Binding Editor.HideAllGroupsCommand}" Padding="8,2" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,6,0,0"
                   Text="Häkchen: Hervorhebung ein/aus. Eintrag anklicken: Gruppe bearbeiten." />
        <ListBox ItemsSource="{Binding Editor.Groups}" SelectedItem="{Binding Editor.SelectedGroupItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupItemViewModel">
              <DockPanel>
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsVisible}" MinWidth="0" Margin="0,0,4,0" ToolTip.Tip="Hervorhebung ein/aus" />
                <Border DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="6" Background="{Binding ColorHex}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" Classes="hint" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Eigenschaften-Panel -->
    <Border DockPanel.Dock="Right" Width="300" BorderBrush="#dddddd" BorderThickness="1,0,0,0">
      <ScrollViewer Padding="10">
        <Panel>
        <!-- Erklär-Modus: Ergebnis, aktueller Schritt mit Begründung, Legende. Ersetzt solange das Eigenschaften-Panel. -->
        <StackPanel x:Name="ExplanationPanel" Spacing="6" IsVisible="{Binding Explain.IsActive}">
          <TextBlock Text="Erklärung" Classes="header" />
          <Border Padding="8,6" CornerRadius="4" BorderThickness="1"
                  Background="{Binding Explain.Severity, Converter={x:Static views:Converters.SeverityBackground}}"
                  BorderBrush="{Binding Explain.Severity, Converter={x:Static views:Converters.SeverityBorder}}">
            <TextBlock Text="{Binding Explain.StatusMessage}" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <TextBlock Text="{Binding Explain.BranchSummary}" Classes="hint" />
          <Rectangle Height="1" Fill="#dddddd" Margin="0,4" />
          <TextBlock Text="{Binding Explain.StepCounterText}" FontWeight="SemiBold" />
          <Border HorizontalAlignment="Left" Padding="8,2" CornerRadius="9"
                  Background="{Binding Explain.IsBranchStep, Converter={x:Static views:Converters.StepBadgeBackground}}">
            <TextBlock Text="{Binding Explain.StepKindText}" FontWeight="SemiBold" FontSize="12"
                       Foreground="{Binding Explain.IsBranchStep, Converter={x:Static views:Converters.StepBadgeForeground}}" />
          </Border>
          <TextBlock Text="{Binding Explain.TechniqueText, StringFormat='Schlussweise: {0}'}" Classes="hint"
                     IsVisible="{Binding Explain.TechniqueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Explain.SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"
                     IsVisible="{Binding Explain.SummaryText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Explain.ReasonText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Explain.RuleText, StringFormat='Regel: {0}'}" Classes="hint"
                     IsVisible="{Binding Explain.RuleText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Rectangle Height="1" Fill="#dddddd" Margin="0,4" />
          <TextBlock Text="Legende" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="26,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
            <TextBlock Grid.Row="0" Text="5" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Given" Classes="hint" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="5" Foreground="#1d4ed8" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="hergeleiteter Wert" Classes="hint" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="5" Foreground="#c2410c" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="geratener Wert (Verzweigung)" Classes="hint" VerticalAlignment="Center" />
            <Ellipse Grid.Row="3" Width="14" Height="14" Fill="#fef08a" Stroke="#ca8a04" StrokeThickness="2" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="vom aktuellen Schritt geändert" Classes="hint" VerticalAlignment="Center" />
            <Ellipse Grid.Row="4" Width="14" Height="14" Fill="#fed7aa" Stroke="#ea580c" StrokeThickness="2" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Verzweigung: hier wird geraten" Classes="hint" VerticalAlignment="Center" />
            <Ellipse Grid.Row="5" Width="14" Height="14" Fill="#bbf7d0" Stroke="#16a34a" StrokeThickness="2" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="verantwortliche Regel (Gruppe/Kante grün)" Classes="hint" VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Text="5" Foreground="#dc2626" TextDecorations="Strikethrough" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="in diesem Schritt gestrichener Kandidat" Classes="hint" VerticalAlignment="Center" />
            <Ellipse Grid.Row="7" Width="16" Height="16" Stroke="#dc2626" StrokeThickness="2" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="Knoten ohne Kandidaten (Widerspruch)" Classes="hint" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="hint" Margin="0,6,0,0"
                     Text="Tasten: ← / → ein Schritt, Pos1 / Ende zum Anfang bzw. Ende, sobald die Schrittleiste den Fokus hat (z. B. nach Klick auf „Vor ›“). Jede Bearbeitung des Rätsels beendet die Erklärung – auch ein Klick mit „Knoten setzen“ oder das Verschieben eines Knotens." />
        </StackPanel>
        <ContentControl Content="{Binding Editor.Properties}" IsVisible="{Binding !Explain.IsActive}">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="vm:PuzzlePropertiesViewModel">
              <StackPanel Spacing="6">
                <TextBlock Text="Rätsel" Classes="header" />
                <TextBlock Text="Name" />
                <TextBox Text="{Binding Name}" />
                <TextBlock Text="{Binding GridText, StringFormat='Gitter: {0}'}" />
                <TextBlock Text="Globaler Wertebereich" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox Text="{Binding DomainMin}" Width="70" />
                  <TextBlock Text="bis" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DomainMax}" Width="70" />
                </StackPanel>
                <TextBlock Text="{Binding DomainError}" Classes="error" IsVisible="{Binding DomainError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Statistics}" Classes="hint" Margin="0,6,0,0" />
                <TextBlock Classes="hint" Margin="0,10,0,0"
                           Text="Knoten setzen: Werkzeug „Knoten setzen“. Knoten auswählen, um Givens einzutragen oder Gruppen zu bilden. Eine Kante anklicken, um ihre Regel zu bearbeiten." />
              </StackPanel>
            </DataTemplate>

            <DataTemplate x:DataType="vm:NodeSelectionPropertiesViewModel">
              <StackPanel Spacing="6">
                <TextBlock Text="Auswahl" Classes="header" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <CheckBox Content="Auswahlreihenfolge anzeigen" IsChecked="{Binding Editor.ShowSelectionOrder}" />
                <TextBlock Text="Neue Gruppe aus Auswahl" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding Editor.GroupRules}" SelectedItem="{Binding Editor.NewGroupRule}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="rules:IRule">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Gruppe erstellen" Command="{Binding Editor.CreateGroupFromSelectionCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <TextBlock Classes="hint" Text="Die Gruppe übernimmt die Auswahlreihenfolge (wichtig für Thermometer). Rahmenauswahl ordnet zeilenweise, Shift-Klick hängt an." />
                <TextBlock Text="Givens" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Classes="hint" Text="Ziffern tippen trägt ein (mehrstellig nacheinander, bei Wertebereich 0–15 auch A–F). ⌫ löscht Givens, Entf löscht die Knoten." />
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <Button Content="Givens löschen" Command="{Binding Editor.ClearGivensCommand}" />
                  <Button Content="Knoten löschen" Command="{Binding Editor.DeleteSelectionCommand}" />
                </WrapPanel>
              </StackPanel>
            </DataTemplate>

            <DataTemplate x:DataType="vm:EdgePropertiesViewModel">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Header}" Classes="header" />
                <TextBlock Text="{Binding Endpoints}" TextWrapping="Wrap" />
                <TextBlock Text="Regel" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="rules:IRule">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding UnknownRule, StringFormat='Unbekannte Regel: {0}'}" Classes="error"
                           IsVisible="{Binding UnknownRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ParameterList}" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
                  <Button Content="Richtung umkehren" Command="{Binding ReverseCommand}" IsVisible="{Binding IsDirected}" />
                  <Button Content="Kante löschen" Command="{Binding DeleteCommand}" />
                </WrapPanel>
              </StackPanel>
            </DataTemplate>

            <DataTemplate x:DataType="vm:GroupPropertiesViewModel">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Header}" Classes="header" />
                <TextBlock Text="Beschriftung" />
                <TextBox Text="{Binding Label}" PlaceholderText="z. B. Zeile 1" />
                <TextBlock Text="Farbe" />
                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorOption">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Swatch}" BorderBrush="#999999" BorderThickness="1" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding CustomColor}" Classes="hint"
                           IsVisible="{Binding CustomColor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="Regel" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="rules:IRule">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding UnknownRule, StringFormat='Unbekannte Regel: {0}'}" Classes="error"
                           IsVisible="{Binding UnknownRule, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ParameterList}" />
                <TextBlock Text="Knoten in Reihenfolge" Margin="0,6,0,0" />
                <TextBlock Text="{Binding NodeOrder}" TextWrapping="Wrap" Classes="hint" />
                <TextBlock Classes="hint" IsVisible="{Binding IsOrdered}"
                           Text="Die Reihenfolge ist für diese Regel bedeutsam. Auf der Zeichenfläche zeigen Zahlen und der Kolben den Anfang." />
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
                  <Button Content="Reihenfolge umkehren" Command="{Binding ReverseOrderCommand}" />
                  <Button Content="Gruppe löschen" Command="{Binding DeleteCommand}" />
                </WrapPanel>
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        </Panel>
      </ScrollViewer>
    </Border>

    <controls:GraphCanvas x:Name="Canvas" DataContext="{Binding Editor}" />
  </DockPanel>
</Window>
