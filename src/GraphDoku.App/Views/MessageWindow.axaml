<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GraphDoku.App.Views.MessageWindow"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel x:Name="Buttons" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0" />
    <ScrollViewer MaxHeight="400">
      <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </ScrollViewer>
  </DockPanel>
</Window>
