<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Solver">
    <PackageVersion Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Bewusst 7.x: FluentAssertions 8 steht unter einer kommerziellen Lizenz (Xceed). -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>
</Project>
