<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet-Sicherheitshinweise bleiben Warnungen, damit neue Advisories den Build nicht spontan brechen. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>Michael Heise</Company>
    <Product>GraphDoku</Product>
    <Copyright>Copyright (c) 2026 Michael Heise. Alle Rechte vorbehalten.</Copyright>
    <NeutralLanguage>de</NeutralLanguage>
    <!-- Lokale Builds tragen 0.0.0-dev; der Release-Workflow setzt die Version aus dem Git-Tag (vX.Y.Z → X.Y.Z). -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>
</Project>
